{
  "name": "foodapp-cameroun",
  "version": "1.0.0",
  "description": "Application de livraison de repas adaptée au marché camerounais",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w packages/api",
    "db:migrate": "npm run db:migrate -w packages/api",
    "db:push": "npm run db:push -w packages/api",
    "db:seed": "npm run db:seed -w packages/api"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "nodemailer": "^8.0.7"
  }
}
