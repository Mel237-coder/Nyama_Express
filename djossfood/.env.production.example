# DjossFood — Environment de production
# Copiez ce fichier en .env.production et remplissez les valeurs.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Campay (paiements)
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_USERNAME=your-campay-username
CAMPAY_PASSWORD=your-campay-password
CAMPAY_WEBHOOK_SECRET=your-webhook-secret

# Admin signup protection
ADMIN_SIGNUP_SECRET=change-this-to-a-random-string

# Redis (facultatif — docker-compose injecte déjà redis://redis:6379)
# REDIS_URL=redis://redis:6379
