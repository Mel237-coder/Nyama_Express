# ===========================================
# CONFIGURATION GÉNÉRALE
# ===========================================

NODE_ENV=development
API_PORT=3001

# URL de l'API (pour le frontend)
API_URL=http://localhost:3001

# URL du Socket.io
SOCKET_URL=http://localhost:3001

# ===========================================
# BASE DE DONNÉES (PostgreSQL)
# ===========================================

DB_USER=foodapp
DB_PASSWORD=foodapp_secret
DB_NAME=foodapp

# Connection string complète (pour Prisma)
DATABASE_URL=postgresql://foodapp:foodapp_secret@localhost:5432/foodapp

# ===========================================
# REDIS
# ===========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ===========================================
# AUTHENTIFICATION (JWT)
# ===========================================

JWT_SECRET=votre_secret_jwt_super_securise_changez_en_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=votre_refresh_secret_jwt_changez_en_production
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# AFRICA'S TALKING (SMS OTP)
# ===========================================

# Clé API trouvée dans votre dashboard Africa's Talking
AFRICASTALKING_API_KEY=

# Nom d'utilisateur (généralement "sandbox" pour les tests)
AFRICASTALKING_USERNAME=sandbox

# ===========================================
# MTN MoMo API
# ===========================================

# Subscription Key depuis le portail développeur MTN
MTN_SUBSCRIPTION_KEY=

# Environnement: "sandbox" pour les tests, "production" pour la prod
MTN_TARGET_ENVIRONMENT=sandbox

# API User et API Key (générés via le portail)
MTN_API_USER=
MTN_API_KEY=

# URL de callback pour les webhooks (doit être accessible depuis l'extérieur)
MTN_CALLBACK_URL=http://localhost:3001/api/payments/momo/callback

# ===========================================
# ORANGE MONEY API
# ===========================================

ORANGE_MONEY_API_KEY=
ORANGE_MONEY_WALLET=
ORANGE_MONEY_CALLBACK_URL=http://localhost:3001/api/payments/orange/callback

# ===========================================
# NOTCHPAY (Agrégateur - fallback)
# ===========================================

# Clé publique NotchPay
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_CALLBACK_URL=http://localhost:3001/api/payments/notchpay/callback

# ===========================================
# CLOUDINARY (Images)
# ===========================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# OPENSEAMAP (Cartes)
# ===========================================

NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org

# ===========================================
# COMMISSION PLATEFORME
# ===========================================

# Pourcentage prélevé sur chaque commande (ex: 15 pour 15%)
PLATFORM_COMMISSION_PERCENT=15

# Frais de livraison par défaut en FCFA
DEFAULT_DELIVERY_FEE=500

# ===========================================
# WHITELIST DOMAINES (CORS)
# ===========================================

ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3001